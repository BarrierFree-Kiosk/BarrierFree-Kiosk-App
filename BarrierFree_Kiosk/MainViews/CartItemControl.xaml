<UserControl x:Class="BarrierFree_Kiosk.MainViews.CartItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="35"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>
                <Image Grid.Row="0"
                       Source="{Binding CardTypeImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Height="20" />
                <Image Grid.Row="1"
                       Source="{Binding CardImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Stretch="Uniform"
                       Width="100"
                       Height="158"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>
            </Grid>
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DeleteButton_Click">
                <Image Source="\Resources\Images\ko_kr\main\btn_cart_del.png" Width="30" Height="30"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
