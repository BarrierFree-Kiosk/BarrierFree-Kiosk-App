<Window x:Class="BarrierFree_Kiosk.MainViews.NavigationHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BarrierFree_Kiosk.Controls"
        xmlns:nav="clr-namespace:BarrierFree_Kiosk.Navigation"
        Title="NavigationHost"
        Height="1920" Width="1080">
    <!--
      참고용 최소 호스트: 하단 Frame에 Page가 표시됩니다.
      시작 창으로 쓰려면 App.xaml의 StartupUri를 MainViews/NavigationHostWindow.xaml 로 바꾸세요.
    -->
    <Grid x:Name="HostRoot">
        <!--
          비율 보정: Page(1080x1920 기준)를 Uniform으로 맞춤.
          화면 확대: 동일 비율로 스케일만 키우고, 뷰포트 밖은 마우스 드래그로 패닝.
        -->
        <Border x:Name="ZoomViewport"
                ClipToBounds="True"
                Background="Transparent"
                PreviewMouseLeftButtonDown="OnZoomPanPreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="OnZoomPanPreviewMouseLeftButtonUp"
                PreviewMouseMove="OnZoomPanPreviewMouseMove"
                MouseLeave="OnZoomPanMouseLeave">
            <Grid x:Name="PanZoomContainer"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ContentZoomScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ContentPanTranslate"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Frame x:Name="RootFrame"
                           NavigationUIVisibility="Hidden"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- 하단 오버레이: 고대비 | 홈 | 화면 확대 -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="12"
                Padding="12"
                Background="#AA111111"
                CornerRadius="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="HighContrastButton"
                        Content="고대비"
                        Margin="4"
                        Padding="16,8"
                        Click="OnHighContrastClick"/>
                <controls:NavigateButton Content="홈" TargetPageId="Home" Margin="4" Padding="16,8"/>
                <Button x:Name="ZoomButton"
                        Content="화면 확대"
                        Margin="4"
                        Padding="16,8"
                        Click="OnZoomClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
