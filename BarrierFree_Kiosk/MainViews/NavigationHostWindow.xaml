<Window x:Class="BarrierFree_Kiosk.MainViews.NavigationHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BarrierFree_Kiosk.Controls"
        xmlns:speech="clr-namespace:BarrierFree_Kiosk.Accessibility"
        Title="NavigationHost"
        Height="1920" Width="1080"
        Background="#0A0A0B">
    <Grid x:Name="HostRoot">
        <Border x:Name="ZoomViewport"
                ClipToBounds="True"
                Background="Transparent"
                PreviewMouseLeftButtonDown="OnZoomPanPreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="OnZoomPanPreviewMouseLeftButtonUp"
                PreviewMouseMove="OnZoomPanPreviewMouseMove"
                MouseLeave="OnZoomPanMouseLeave">
            <Grid x:Name="PanZoomContainer"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ContentZoomScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ContentPanTranslate"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Frame x:Name="RootFrame"
                           NavigationUIVisibility="Hidden"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- sub_bg_03.png 하단 보라색 띠 높이에 맞춰 도크 크기 확장 -->
        <Border x:Name="AccessibilityDock"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Padding="16,0"
                ClipToBounds="False"
                Background="{StaticResource AccessibilityDockBackgroundBrush}"
                BorderThickness="0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom">
                <Button x:Name="HighContrastButton"
                        Style="{StaticResource AccessibilityToolButton}"
                        Click="OnHighContrastClick"
                        speech:SpeechAssist.HoverSpeechText="고대비 모드를 켭니다.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="30" Height="30" Margin="0,0,8,0">
                            <Path Data="M12,2A10,10 0 1,0 12,22A10,10 0 1,0 12,2M12,4V20M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20"
                                  Fill="{StaticResource AccessibilityToolOnPurpleBrush}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock x:Name="HighContrastLabel"
                                   Text="고대비"
                                   Style="{StaticResource AccessibilityToolLabelOnPurple}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1"
                        Margin="8,10"
                        Background="#55FFFFFF"/>

                <controls:NavigateButton x:Name="HomeButton"
                                         TargetPageId="Home"
                                         Style="{StaticResource AccessibilityToolButton}"
                                         speech:SpeechAssist.HoverSpeechText="홈 화면으로 이동합니다.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="30" Height="30" Margin="0,0,8,0">
                            <Path Data="M12,3L4,10V20H10V14H14V20H20V10L12,3Z"
                                  Fill="{StaticResource AccessibilityToolOnPurpleBrush}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="홈"
                                   Style="{StaticResource AccessibilityToolLabelOnPurple}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </controls:NavigateButton>

                <Border Width="1"
                        Margin="8,10"
                        Background="#55FFFFFF"/>

                <Button x:Name="ZoomButton"
                        Style="{StaticResource AccessibilityToolButton}"
                        Click="OnZoomClick"
                        speech:SpeechAssist.HoverSpeechText="화면을 확대합니다. 드래그로 이동할 수 있습니다.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="30" Height="30" Margin="0,0,8,0">
                            <Path Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.49L20.49,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14M11,7V9.5H13.5V11H11V13.5H9.5V11H7V9.5H9.5V7H11Z"
                                  Fill="{StaticResource AccessibilityToolOnPurpleBrush}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock x:Name="ZoomLabel"
                                   Text="화면 확대"
                                   Style="{StaticResource AccessibilityToolLabelOnPurple}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
