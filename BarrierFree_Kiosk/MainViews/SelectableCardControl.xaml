<UserControl x:Class="BarrierFree_Kiosk.MainViews.SelectableCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="120">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderThickness="4"
                BorderBrush="{Binding SelectionBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CornerRadius="8">
            <Button Background="Transparent"
                    BorderThickness="0"
                    Margin="0"
                    Click="CardButton_Click">
                <Image Source="{Binding CardImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Stretch="Uniform"
                       MaxHeight="150"/>
            </Button>
        </Border>

        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Image Source="{Binding CardTypeImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Stretch="Uniform"
                   Height="28"
                   VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
