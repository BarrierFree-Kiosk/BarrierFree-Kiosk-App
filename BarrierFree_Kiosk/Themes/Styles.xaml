<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- sub_bg_03.png 하단 보라색 띠 (RGB 121,124,202) -->
    <SolidColorBrush x:Key="AccessibilityDockBackgroundBrush" Color="#FF797CCA"/>
    <SolidColorBrush x:Key="AccessibilityDockBorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="AccessibilityToolOnPurpleBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccessibilityToolMutedOnPurpleBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="AccessibilityToolActiveOnPurpleBrush" Color="#FFFFF3B0"/>
    <SolidColorBrush x:Key="AccessibilityToolHoverOnPurpleBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="AccessibilityToolPressedOnPurpleBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="AccessibilityToolForegroundBrush" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="AccessibilityToolMutedBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="AccessibilityToolActiveBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="AccessibilityToolHoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="AccessibilityToolPressedBrush" Color="#33FFFFFF"/>

    <Style x:Key="AccessibilityToolLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AccessibilityToolMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AccessibilityToolLabelOnPurple" TargetType="TextBlock" BasedOn="{StaticResource AccessibilityToolLabel}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource AccessibilityToolMutedOnPurpleBrush}"/>
    </Style>

    <Style x:Key="AccessibilityToolButton" TargetType="Button">
        <Setter Property="MinWidth" Value="128"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AccessibilityToolOnPurpleBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource AccessibilityToolHoverOnPurpleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource AccessibilityToolPressedOnPurpleBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="RootBorder" Property="Background" Value="#40FFFFFF"/>
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource AccessibilityToolActiveOnPurpleBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Active"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RootBorder" Property="Background" Value="#66FFFFFF"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
