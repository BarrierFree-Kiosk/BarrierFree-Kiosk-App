<Page x:Class="BarrierFree_Kiosk.WorkSpace.Jungmin.Jungmin2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BarrierFree_Kiosk.WorkSpace.Jungmin"
      mc:Ignorable="d" 
      d:DesignHeight="1920" d:DesignWidth="1080"
      Title="Jungmin2">
    <!--전체 비율-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>

        <!--영상-->
        <MediaElement x:Name="MainVideo" 
                      Grid.Row="0" 
                      Source="\Resources\Images\NIKKE2nd_15s.mp4" 
                      LoadedBehavior="Play" 
                      UnloadedBehavior="Manual" 
                      MediaEnded="MediaElement_MediaEnded" 
                      Stretch="UniformToFill" />

        <!--배경 이미지-->
        <Grid Grid.Row="1">
            <Image Source="\Resources\Images\ko_kr\main\sub_bg_03.png" Stretch="Fill" Margin="0"/>

            <!--선택 담기, 구매하기 버튼 영역-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74*"/>
                    <ColumnDefinition Width="23*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!--My list 영역-->
                <Grid Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.4*"/>
                        <ColumnDefinition Width="91.3*"/>
                        <ColumnDefinition Width="3.3*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="39*"/>
                        <RowDefinition Height="17.3*"/>
                        <RowDefinition Height="62*"/>
                    </Grid.RowDefinitions>

                    <!--고객 이름 영역-->
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="13*"/>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="10*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="13*"/>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="64*"/>
                        </Grid.ColumnDefinitions>

                        <!--고객 이름-->
                        <TextBlock x:Name="TxtUserName" Grid.Row="1" Grid.Column="1" 
                                   Text="홍길동" FontSize="35" FontWeight="Bold" 
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="Black"/>
                    </Grid>

                    <!--My list 패널-->
                    <Border Grid.Row="1" Grid.Column="1" Background="Transparent">
                        <StackPanel x:Name="MyListContainer" Orientation="Horizontal"/>
                    </Border>

                    <!--미리보기 사진 영역-->
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2.2*"/>
                            <RowDefinition Height="31*"/>
                            <RowDefinition Height="40*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26*"/>
                            <ColumnDefinition Width="19.5*"/>
                            <ColumnDefinition Width="9*"/>
                            <ColumnDefinition Width="19.5*"/>
                            <ColumnDefinition Width="26*"/>
                        </Grid.ColumnDefinitions>
                        <!--미리보기 사진 1-->
                        <Border x:Name="CardFrontArea" Grid.Row="1" Grid.Column="1" Background="Transparent">
                            <Image x:Name="ImgCardFront" Stretch="Uniform"/>
                        </Border>
                        <!--미리보기 사진 2-->
                        <Border x:Name="CardBackArea" Grid.Row="1" Grid.Column="3" Background="Transparent">
                            <Image x:Name="ImgCardBack" Stretch="Uniform"/>
                        </Border>
                    </Grid>

                    <!--장바구니 영역-->
                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="26*"/>
                            <RowDefinition Height="10.5*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="68*"/>
                                <ColumnDefinition Width="24*"/>
                            </Grid.ColumnDefinitions>

                            <!--장바구니 패널-->
                            <Border Grid.Column="1" Background="Transparent">
                                <StackPanel x:Name="CartContainer" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!--버튼 영역-->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55*"/>
                        <RowDefinition Height="9*"/>
                        <RowDefinition Height="5*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>

                    <!--선택담기 버튼-->
                    <Button Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <Image Source="\Resources\Images\ko_kr\main\btn_cart.png" Stretch="Uniform"/>
                    </Button>

                    <!--금액 텍스트 영역-->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <!--금액 입력-->
                        <TextBlock x:Name="TxtTotalPrice" Grid.Column="1" 
                                   Text="4000" FontSize="40" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                    </Grid>

                    <Button Grid.Row="3" Background="Transparent" BorderThickness="0">
                        <Image Source="\Resources\Images\ko_kr\main\btn_payment.png" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>