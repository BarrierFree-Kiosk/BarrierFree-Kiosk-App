<Window x:Class="BarrierFree_Kiosk.WorkSpace.Subin.MessagePopup_Text03"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="690"
        Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E282D">

    <Grid Background="#1E282D">
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#3A464B"
                BorderThickness="0,0,0,1">
            <TextBlock Text="MESSAGE"
                       Foreground="White"
                       FontSize="31"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="22,0,0,0"/>
        </Border>

        <Grid Grid.Row="1">
            <Image Source="/Resources/Images/ko_kr/popup/text_03.png"
                   Width="520"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>