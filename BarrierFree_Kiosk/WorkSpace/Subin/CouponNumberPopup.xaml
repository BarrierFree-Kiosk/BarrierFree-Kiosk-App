                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- clear -->
                    <Button Grid.Row="6" Grid.Column="4" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="KeyDeleteNormal" Source="/Resources/Images/Popup/btn_key_delete.png" Stretch="Fill"/>
                            <Image x:Name="KeyDeleteOn" Source="/Resources/Images/Popup/btn_key_delete_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
