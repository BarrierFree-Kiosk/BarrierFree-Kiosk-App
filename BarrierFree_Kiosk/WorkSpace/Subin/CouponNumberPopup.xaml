<Window x:Class="BarrierFree_Kiosk.WorkSpace.Subin.CouponNumberPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800"
        Height="810"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>

        <!-- 키패드 공통 버튼 스타일 -->
        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- 팝업 배경 -->
        <Image Source="/Resources/Images/ko_kr/popup/popup_bg.png"
               Stretch="Fill"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 상단바 -->
            <Grid Grid.Row="0">
                <Image Source="/Resources/Images/Popup/btn_act_arrow_pre.png"
                       Width="48"
                       Height="48"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="48,0,0,0"/>

                <TextBlock Text="쿠폰번호 입력"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="#2F3137"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 본문 -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="360"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 안내 문구 -->
                <TextBlock Grid.Row="1"
                           Text="쿠폰번호를 입력해 주세요"
                           FontSize="39"
                           Foreground="#333333"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- 입력창 -->
                <Border Grid.Row="3"
                        Width="500"
                        Height="92"
                        Background="White"
                        CornerRadius="46"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <TextBlock Text="12**"
                               FontSize="46"
                               FontWeight="Bold"
                               Foreground="#2F3137"
                               VerticalAlignment="Center"
                               Margin="54,0,0,0"/>
                </Border>

                <!-- 키패드 -->
                <Grid Grid.Row="5"
                      Width="445"
                      Height="330"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1 -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="Key01Normal" Source="/Resources/Images/Popup/btn_key01.png" Stretch="Fill"/>
                            <Image x:Name="Key01On" Source="/Resources/Images/Popup/btn_key01_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key01On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.01"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key01On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 2 -->
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="Key02Normal" Source="/Resources/Images/Popup/btn_key02.png" Stretch="Fill"/>
                            <Image x:Name="Key02On" Source="/Resources/Images/Popup/btn_key02_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key02On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.01"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key02On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 3 -->
                    <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="Key03Normal" Source="/Resources/Images/Popup/btn_key03.png" Stretch="Fill"/>
                            <Image x:Name="Key03On" Source="/Resources/Images/Popup/btn_key03_on.png" Stretch="Fill" Opacity="0"/>
