                            <Image x:Name="Key05On" Source="/Resources/Images/Popup/btn_key05_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
