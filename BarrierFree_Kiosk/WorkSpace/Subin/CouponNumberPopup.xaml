                                        <DoubleAnimation Storyboard.TargetName="Key08On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.01"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key08On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 9 -->
                    <Button Grid.Row="4" Grid.Column="4" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="Key09Normal" Source="/Resources/Images/Popup/btn_key09.png" Stretch="Fill"/>
                            <Image x:Name="Key09On" Source="/Resources/Images/Popup/btn_key09_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key09On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.01"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key09On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- back -->
                    <Button Grid.Row="6" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="KeyBackNormal" Source="/Resources/Images/Popup/btn_key_back.png" Stretch="Fill"/>
                            <Image x:Name="KeyBackOn" Source="/Resources/Images/Popup/btn_key_back_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KeyBackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.01"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KeyBackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 0 -->
                    <Button Grid.Row="6" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="Key00Normal" Source="/Resources/Images/Popup/btn_key00.png" Stretch="Fill"/>
                            <Image x:Name="Key00On" Source="/Resources/Images/Popup/btn_key00_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
