                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key05On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 6 -->
                    <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="Key06Normal" Source="/Resources/Images/Popup/btn_key06.png" Stretch="Fill"/>
                            <Image x:Name="Key06On" Source="/Resources/Images/Popup/btn_key06_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key06On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.01"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key06On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 7 -->
                    <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="Key07Normal" Source="/Resources/Images/Popup/btn_key07.png" Stretch="Fill"/>
                            <Image x:Name="Key07On" Source="/Resources/Images/Popup/btn_key07_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key07On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.01"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key07On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 8 -->
                    <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="Key08Normal" Source="/Resources/Images/Popup/btn_key08.png" Stretch="Fill"/>
                            <Image x:Name="Key08On" Source="/Resources/Images/Popup/btn_key08_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                <BeginStoryboard>
