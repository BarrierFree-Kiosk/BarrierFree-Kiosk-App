                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Key03On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 4 -->
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}">
                        <Grid>
                            <Image x:Name="Key04Normal" Source="/Resources/Images/Popup/btn_key04.png" Stretch="Fill"/>
                            <Image x:Name="Key04On" Source="/Resources/Images/Popup/btn_key04_on.png" Stretch="Fill" Opacity="0"/>
                        </Grid>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                <BeginStoryboard>
