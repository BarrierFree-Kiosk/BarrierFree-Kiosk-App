<Window x:Class="BarrierFree_Kiosk.WorkSpace.Sua.CardInsertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:speech="clr-namespace:BarrierFree_Kiosk.Accessibility"
        speech:SpeechAssist.WindowSpeechText="카드를 삽입해주세요."
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Title="카드 결제">
    <Window.Resources>
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Grid>
                                <Image Source="{TemplateBinding Tag}" Stretch="Fill"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#66000000">
        <Border Margin="28"
                Width="560"
                Height="430"
                Padding="24"
                Background="White"
                CornerRadius="20"
                BorderBrush="#FFD9D9D9"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="카드를 삽입해 주세요"
                           FontSize="40"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14" />

                <TextBlock Grid.Row="1"
                           Text="리더기 연결 후 자동으로 결제를 진행합니다."
                           FontSize="22"
                           Foreground="#FF555555"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <ProgressBar x:Name="ConnectionProgress"
                             Grid.Row="2"
                             Height="24"
                             Minimum="0"
                             Maximum="100"
                             Value="20"
                             Margin="0,0,0,20" />

                <StackPanel Grid.Row="3" VerticalAlignment="Top">
                    <TextBlock x:Name="TxtConnectionStatus"
                               Text="카드 단말기 연결 중..."
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18" />

                    <Button x:Name="BtnClose"
                            Content="취소"
                            MinWidth="180"
                            MinHeight="64"
                            FontSize="24"
                            FontWeight="Bold"
                            Background="#FF1E88E5"
                            Style="{StaticResource ImageButtonStyle}"
                            Tag="\Resources\Images\payment\btn_cancel.png"
                            HorizontalAlignment="Center"
                            Click="BtnClose_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
