<Window x:Class="BarrierFree_Kiosk.WorkSpace.Sua.MessagePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:speech="clr-namespace:BarrierFree_Kiosk.Accessibility"
        speech:SpeechAssist.WindowSpeechText="쿠폰 번호(8자리)를 다시 확인해주십시오."
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Title="MESSAGE">
    <Grid Background="#66000000">
        <Border Margin="24"
                Width="560"
                Height="430"
                CornerRadius="18"
                BorderBrush="#FFCAD7E8"
                BorderThickness="2"
                Background="#FFDCE7F3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MESSAGE"
                               Margin="16,0,0,0"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#FF1F2B3A"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="BtnClose"
                            Content="✕"
                            Click="BtnClose_Click"
                            Margin="0,0,12,0"
                            FontSize="34"
                            Foreground="#FF1F2B3A"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="!"
                               FontSize="70"
                               Foreground="#FFD98796"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18"/>
                    <TextBlock x:Name="TxtMessage"
                               Text="쿠폰 번호(8자리)를 확인해 주십시오."
                               FontSize="30"
                               Foreground="#FF3A4858"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Row="2"
                        x:Name="BtnConfirm"
                        Content="확인"
                        Click="BtnConfirm_Click"
                        Margin="0,0,0,22"
                        MinWidth="130"
                        Height="52"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#FFAB295F"
                        BorderThickness="0"
                        Cursor="Hand"
                        speech:SpeechAssist.HoverSpeechText="확인 버튼입니다."/>
            </Grid>
        </Border>
    </Grid>
</Window>
